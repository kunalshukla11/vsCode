{
  "workbench.editor.enablePreview": false,
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "files.autoSave": "onFocusChange",
  "editor.lineNumbers": "relative",
  "workbench.startupEditor": "none",
  "editor.formatOnSave": true,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "git.autofetch": true,
  "prettier.singleQuote": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "window.zoomLevel": 1,
  "prettier.jsxSingleQuote": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "javascript.preferences.quoteStyle": "single",
  "typescript.preferences.quoteStyle": "single",
  "html.completion.attributeDefaultValue": "singlequotes",
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "ngClass",
    "classNames"
  ],
  "workbench.sideBar.location": "right",
  "markdown.updateLinksOnFileMove.enabled": "prompt",
  "terminal.integrated.cursorStyle": "underline",
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "editor.fontSize": 13,
  "github.copilot.advanced": {
    "authProvider": "github"
  },
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  // Adding settings later for vsCode Neovim extension
  "zenMode.showTabs": "single",
  "zenMode.centerLayout": false,
  "zenMode.hideLineNumbers": false,
  "workbench.colorTheme": "Tokyo Night",
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": true,

  // "terminal.integrated.defaultProfile.osx": "tmux-shell",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "vscode-neovim.compositeKeys": {
    "jk": {
      "command": "vscode-neovim.escape"
    }
  },
  "editor.linkedEditing": true,
  "editor.unicodeHighlight.includeComments": true,
  "workbench.editor.revealIfOpen": true,
  "emmet.variables": {
    "lang": "en"
  },
  "terminal.integrated.tabs.hideCondition": "never",
  "terminal.integrated.enablePersistentSessions": false,
  "editor.bracketPairColorization.enabled": true,
  "workbench.colorCustomizations": {
    "editorBracketMatch.border": "#9da0a2",
    "editorBracketMatch.background": "#011627"
  },
  "window.newWindowProfile": "Default"
  //Tooggle the if nulllable code start showing error in vs code
  //   "java.compile.nullAnalysis.nonnull": [],
  //   "java.compile.nullAnalysis.nullable": []
}
